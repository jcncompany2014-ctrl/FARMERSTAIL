# 릴리스 서명 설정 예시 — 이 파일을 keystore.properties 로 복사해 채운다.
# ⚠️ keystore.properties 와 .jks 파일은 절대 커밋하지 않는다(.gitignore 처리됨).
#
# 키스토어 생성(최초 1회):
#   keytool -genkey -v -keystore farmerstail-release.jks -keyalg RSA \
#     -keysize 2048 -validity 10000 -alias farmerstail
#
# storeFile 은 android/ 기준 상대경로 또는 절대경로.
storeFile=../farmerstail-release.jks
storePassword=여기에_키스토어_비밀번호
keyAlias=farmerstail
keyPassword=여기에_키_비밀번호
