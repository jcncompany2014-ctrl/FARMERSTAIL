<?xml version="1.0" encoding="utf-8"?>
<!-- 안드로이드 12+ 시스템 스플래시 아이콘(windowSplashScreenAnimatedIcon) — 앱 아이콘과 같은 적응형 구조, 앞면은 앱
     아이콘 앞면(같은 도장 그림). 웹 로딩 화면(components/AppSplash.tsx, 칸 132·도장 126dp)과 같은 크기가 되도록
     여백을 22% 로 둔다: 앱 아이콘 그대로(16.7%)면 시스템이 이 아이콘을 앱 아이콘보다 1.19배 크게 그려(지름 152dp)
     폰 화면 → 웹으로 넘어갈 때 도장이 줄어드는 게 보였다(2026-10-08 에뮬레이터 녹화 실측: 139px 대 117px).
     (1 − 2×0.167) × 117/139 = 0.56 → 여백 22%. 뒷면은 앱 종이색 — 앱 아이콘 뒷면(크림)이면 바탕 위에 옅은 원이 비친다.
     ⚠️ 비트맵을 dp 여백으로 감싼 그림은 안 된다: 시스템이 적응형이 아닌 그림을 108dp 칸에 놓고 키우는데,
     여백이 칸을 넘어 도장이 점처럼 작아졌다(같은 날 실측). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ft_splash_bg" />
    <foreground>
        <inset android:drawable="@mipmap/ic_launcher_foreground" android:inset="22%" />
    </foreground>
</adaptive-icon>
