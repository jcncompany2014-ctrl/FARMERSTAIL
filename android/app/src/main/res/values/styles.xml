<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- 앱 화면(웹뷰) 테마 — Capacitor BridgeActivity 가 켜질 때 이 테마로 바꾼다(R.style.AppTheme_NoActionBar).
         ★2026-10-14 다음 앱 빌드(셸 정리, 규칙240): 아래 손짓 막대 구간이 검은 띠였다 — 흰 셸(FtShell/3)과 맞춘다.
         · windowBackground 흰색: 안드로이드 15+ 는 가장자리까지 그리기가 강제라(targetSdk 36) 막대 색(navigationBarColor)을
           무시하고 그 자리에 창 바탕을 보인다(Capacitor SystemBars 가 decorView 바탕을 windowBackground 로 칠한다).
           DayNight 기본 바탕은 기기가 다크 모드면 어둡다 — 그래서 흰색으로 못 박는다.
         · 막대 색·밝은 막대(어두운 버튼)는 values-v27/styles.xml — windowLightNavigationBar 가 API 27 부터라 그 아래(24~26)에서
           흰 막대를 칠하면 흰 버튼이 흰 바탕에 묻힌다. 공통 항목은 Base 에 두고 v27 판이 그걸 이어받는다. -->
    <style name="Base.AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/ft_splash_bg</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Base.AppTheme.NoActionBar" />


    <!-- 부모가 Theme.SplashScreen.IconBackground 여야 아래 아이콘 뒷면 색이 안드로이드 12+ 에 실제로 넘어간다
         (그냥 Theme.SplashScreen 이면 무시돼 도장이 1.2배 크게 그려졌다 — 에뮬레이터 실측). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen.IconBackground">
        <!-- 앱 켤 때 폰 화면 = 흰 바탕 정중앙 도장(2026-10-08 · 바탕 흰색은 10-09). 안드로이드 12+ 는 OS 가 아이콘 칸(288dp)에
             그리고, 그보다 옛 기종은 drawable/splash(같은 그림)를 쓴다. 웹 로딩 화면(AppSplash)이 같은
             도장을 같은 자리에 그린 뒤 이 화면을 걷는다 — 로딩이 한 번으로 보인다. -->
        <item name="windowSplashScreenBackground">@color/ft_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <!-- 아이콘 뒷면 색을 정해야 앱 아이콘과 같은 크기 규칙(240dp 칸)으로 그린다. 안 정하면 '뒷면 없는 아이콘'
             규칙(288dp 칸)이라 도장이 1.2배 커져 웹 로딩의 도장보다 커 보였다(에뮬레이터 실측). 바탕과 같은 색이라 원은 안 보인다. -->
        <item name="windowSplashScreenIconBackgroundColor">@color/ft_splash_bg</item>
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>