# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
# OS 부산물 — public/desktop.ini 가 실제로 배포에 섞여 나간 적 있다(탐색기가 생성).
.DS_Store
desktop.ini
Thumbs.db
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.example 은 템플릿 — 키 채우는 가이드용으로 commit.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*.local

# design handoff dumps (screenshots, zips, HTML exports) — not source
.claude-design/

# Capacitor — 네이티브 빌드 산출물 / 임시 webDir
# ─────────────────────────────────────────────────
# ios/, android/ 자체는 commit (네이티브 설정·서명 인증서·plugin 등록 등이
# 포함). 다만 빌드 결과물 / Pods / 캐시는 무시.
/capacitor-web/
/ios/App/Pods/
/ios/App/build/
/ios/App/App.xcworkspace/xcuserdata/
/ios/App/App.xcodeproj/xcuserdata/
/ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/
/ios/DerivedData/
/android/.gradle/
/android/build/
/android/app/build/
/android/app/release/
/android/local.properties
/android/.idea/
/android/app/*.iml
/android/captures/

# Capacitor 자산 생성 산출물은 commit 함 (스토어 제출 시 필요).
# 단 source PSD/AI 같은 디자인 원본은 별도 폴더에서 관리.

# ── 안드로이드 서명 키 — 저장소 최상위에 존재한다(keystore.properties 의
#    storeFile=../farmerstail-release.jks). android/.gitignore 의 *.jks 는
#    android/ 하위만 덮어서 **최상위 키가 무방비**였다(2026-09-01 맥에서 배치하다
#    발견 — 공개 저장소라 add -A 한 번이면 서명 키가 공개될 뻔했다).
*.jks
*.keystore
keystore.properties
